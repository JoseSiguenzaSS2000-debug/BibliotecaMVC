<div class="container-fluid bg-dark text-white py-4">
    <div class="text-center">
        <h1 class="display-5 fw-bold">Acerca de nuestra Biblioteca</h1>
        <p class="lead">Un espacio dedicado al aprendizaje, la lectura y el conocimiento.</p>
    </div>
</div>


<div class="container mt-4">

    <div class="row">

        <!-- apartado informacion principal donde va el mision y vision que ahora va con InfoCard -->

        <div class="col-md-8 mb-4">

            @await Html.PartialAsync("_InfoCard", new BibliotecaMVC.Models.InfoCard { Title = "¿Quienes somos?", Text = "Somos una biblioteca creada para facilitar el acceso a libros y recursos educativos, ofreciendo un espacio donde los usuarios puedan aprender, investigar y disfrutar de la lectura." })

            <div class="mt-4">

                @await Html.PartialAsync("_InfoCard", new BibliotecaMVC.Models.InfoCard { Title = "Misión", Text = "Brindar acceso a recursos bibliográficos de calidad y promover el hábito de la lectura, contribuyendo al aprendizaje y desarrollo de nuestra comunidad." })

            </div>

            <div class="mt-4">

                @await Html.PartialAsync("_InfoCard", new BibliotecaMVC.Models.InfoCard { Title = "Visión", Text = "Ser una biblioteca moderna y accesible, reconocida por ofrecer una amplia variedad de recursos y por fomentar el conocimiento, la educación y la cultura." })

            </div>

        </div>


        <!-- zona de informacion -->

        <div class="col-md-4 mb-4">

            @await Html.PartialAsync("_InfoCard", new BibliotecaMVC.Models.InfoCard { Title = "Información", Text = "Consulta nuestra colección de libros y encuentra recursos para tus estudios y proyectos. Explora, aprende y descubre nuevas historias a través de nuestra biblioteca." })

        </div>

    </div>


    <!-- servicios de la Biblioteca -->

    <div class="row mt-4">

        <div class="col-md-6 mb-4">

            @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/300/150", Text = "Consulta los libros disponibles en nuestra biblioteca" })

        </div>


        <div class="col-md-6 mb-4">

            @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/300/150", Text = "Encuentra recursos para tus estudios y proyectos" })

        </div>
         
    </div>


    <!-- apartado de nuestra Biblioteca -->

    <div class="card about-card shadow-sm h-100">
        <div class="card-body">

            <h2 class="h3 fw-bold mb-3">Nuestra Biblioteca</h2>

            <img src="https://picsum.photos/1200/300"
                 class="img-fluid rounded w-100"
                 alt="Nuestra Biblioteca">

            <p class="text-center text-muted fst-italic mt-3">
                Un espacio creado para fomentar la lectura y el aprendizaje.
            </p>

        </div>
    </div>

</div>