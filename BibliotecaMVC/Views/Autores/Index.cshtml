@model IEnumerable<BibliotecaMVC.Models.Autor>
@{
    ViewData["Title"] = "Listado de Autores";
}

<h1>@ViewData["Title"]</h1>
<p>Hay @Model.Count() autores registrados</p>

<a class="btn btn-primary mb-3" asp-action="Create">Nuevo Autor +</a>

<div class="row">
    @foreach (var autor in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@autor.Nombre</h5>
                    <h6>@autor.Nacionalidad</h6>
                    <p>Edad: @(DateTime.Now.Year - autor.FechaNacimiento.Year)</p>

                    <a class="btn btn-info" asp-action="Details" asp-route-id="@autor.Id">Ver</a>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@autor.Id">Editar</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@autor.Id">Eliminar</a>

                </div>
            </div>
        </div>
    }
</div>